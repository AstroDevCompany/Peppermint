MOZ_SRC_FILES += [
    "PeppermintArchiveActions.sys.mjs",
    "PeppermintTabArchive.sys.mjs",
    "PeppermintTabArchiveStore.sys.mjs",
    "PeppermintUrlbarProviderArchive.sys.mjs",
]

# Registered through components.conf, which needs a resource:/// URL.
EXTRA_JS_MODULES.zen.tabarchive += [
    "PeppermintAboutArchive.sys.mjs",
]

XPCOM_MANIFESTS += [
    "components.conf",
]
