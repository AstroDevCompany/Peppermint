## Sidebar notification, see ZenSidebarNotification.mjs for how these are used

peppermint-update-ready-heading = Update ready
peppermint-update-available-heading = Update available

peppermint-update-restart-label = Restart to update
peppermint-update-restart-tooltip =
    .title = Restart { -brand-short-name } and install the update
peppermint-update-download-label = Download the update
peppermint-update-download-tooltip =
    .title = Open the download page

## Toasts, shown when the sidebar is collapsed

peppermint-update-ready-toast = Update ready. Open About { -brand-short-name } to install it.
peppermint-update-available-toast = Update available. Open About { -brand-short-name } to get it.

## About dialog

peppermint-update-check-button =
    .label = Check for updates
peppermint-update-checking = Checking for updates…
# $percent (Number) - download progress from 0 to 100.
peppermint-update-downloading = Downloading update… { $percent }%
peppermint-update-up-to-date = { -brand-short-name } is up to date
# $version (String) - the new version.
peppermint-update-ready = Version { $version } is ready to install
peppermint-update-restart-button =
    .label = Restart to update
# $version (String) - the new version.
peppermint-update-manual = Version { $version } is available
peppermint-update-download-button =
    .label = Download
peppermint-update-failed = The update check failed. Try again later.
